# Ask Zacky AI - Cloud LLM API Keys
# Dapatkan Google Gemini API Key gratis (100% free tier, tanpa kartu kredit) di:
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# (Opsional / Alternatif) Atau gunakan Groq Cloud API Key di:
# https://console.groq.com/keys
# GROQ_API_KEY=

# (Opsional) Domain tambahan yang boleh memanggil /api/chat, dipisah koma.
# Domain website sendiri selalu diizinkan otomatis.
# ALLOWED_ORIGINS=domainku.com,www.domainku.com
